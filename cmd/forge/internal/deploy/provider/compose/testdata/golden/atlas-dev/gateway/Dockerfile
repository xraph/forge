# Generated by forge deploy.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY . .
WORKDIR /src/.
ENV CGO_ENABLED=0
RUN ["go","build","-mod=mod","-trimpath","-ldflags","-s -w","-o","/out/app","./cmd/gateway"]

FROM alpine:3.22
RUN apk add --no-cache ca-certificates wget && adduser -D -u 65532 forge
USER forge
WORKDIR /app
COPY --from=build /out/app /app/app
ENTRYPOINT ["/app/app"]
