{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "go",
      "package-name": "forge",
      "include-component-in-tag": false,
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance Improvements" },
        { "type": "revert", "section": "Reverts" },
        { "type": "docs", "section": "Documentation", "hidden": false },
        { "type": "style", "section": "Styles", "hidden": true },
        { "type": "chore", "section": "Miscellaneous Chores", "hidden": true },
        { "type": "refactor", "section": "Code Refactoring", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "build", "section": "Build System", "hidden": true },
        { "type": "ci", "section": "Continuous Integration", "hidden": true }
      ]
    },
    "extensions/auth": {
      "release-type": "go",
      "package-name": "auth",
      "component": "extensions/auth"
    },
    "extensions/cache": {
      "release-type": "go",
      "package-name": "cache",
      "component": "extensions/cache"
    },
    "extensions/consensus": {
      "release-type": "go",
      "package-name": "consensus",
      "component": "extensions/consensus"
    },
    "extensions/discovery": {
      "release-type": "go",
      "package-name": "discovery",
      "component": "extensions/discovery"
    },
    "extensions/events": {
      "release-type": "go",
      "package-name": "events",
      "component": "extensions/events"
    },
    "extensions/features": {
      "release-type": "go",
      "package-name": "features",
      "component": "extensions/features"
    },
    "extensions/graphql": {
      "release-type": "go",
      "package-name": "graphql",
      "component": "extensions/graphql"
    },
    "extensions/grpc": {
      "release-type": "go",
      "package-name": "grpc",
      "component": "extensions/grpc"
    },
    "extensions/hls": {
      "release-type": "go",
      "package-name": "hls",
      "component": "extensions/hls"
    },
    "extensions/kafka": {
      "release-type": "go",
      "package-name": "kafka",
      "component": "extensions/kafka"
    },
    "extensions/mcp": {
      "release-type": "go",
      "package-name": "mcp",
      "component": "extensions/mcp"
    },
    "extensions/mqtt": {
      "release-type": "go",
      "package-name": "mqtt",
      "component": "extensions/mqtt"
    },
    "extensions/orpc": {
      "release-type": "go",
      "package-name": "orpc",
      "component": "extensions/orpc"
    },
    "extensions/queue": {
      "release-type": "go",
      "package-name": "queue",
      "component": "extensions/queue"
    },
    "extensions/search": {
      "release-type": "go",
      "package-name": "search",
      "component": "extensions/search"
    },
    "extensions/security": {
      "release-type": "go",
      "package-name": "security",
      "component": "extensions/security"
    },
    "extensions/streaming": {
      "release-type": "go",
      "package-name": "streaming",
      "component": "extensions/streaming"
    },
    "extensions/webrtc": {
      "release-type": "go",
      "package-name": "webrtc",
      "component": "extensions/webrtc"
    }
  },
  "changelog-path": "CHANGELOG.md",
  "tag-separator": "/",
  "separate-pull-requests": true,
  "pull-request-title-pattern": "chore(${scope}): release ${component} ${version}",
  "skip-github-release": true
}
