    "/sinks/{sinkId}/events/{eventId}": {
      "post": {
        "deprecated": true,
        "parameters": [
          {
            "name": "sinkId",
            "in": "path",
            "description": "Sink identifier",
            "required": true,
            "schema": {
              "type": "string",
