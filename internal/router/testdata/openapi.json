            }
          },
          {
            "name": "eventId",
            "in": "path",
            "description": "Path parameter: eventId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Region",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Request body",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/goldenSinkRequestBody"
              },
              "examples": {
                "minimal": {
                  "summary": "minimal",
                  "value": {
                    "body": "hello"
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/goldenSinkRequestBody"
              },
              "examples": {
                "minimal": {
                  "summary": "minimal",
                  "value": {
                    "body": "hello"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/goldenSummary"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Kitchen-sink operation",
        "tags": [
