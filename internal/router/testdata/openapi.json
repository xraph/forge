  "components": {
    "schemas": {
      "BillingInvoice": {
        "type": "object",
        "required": [
          "invoice_number",
          "amount_cents",
          "note"
        ],
        "properties": {
          "amount_cents": {
            "type": "integer"
          },
          "invoice_number": {
            "type": "string"
          },
          "note": {
            "$ref": "#/components/schemas/BillingNote"
          }
        }
      },
      "BillingNote": {
        "type": "object",
        "required": [
          "memo"
        ],
        "properties": {
          "memo": {
            "type": "string"
          }
        }
      },
      "GoldenOrderStatus": {
        "type": "string",
        "enum": [
          "draft",
          "open",
          "closed"
        ]
      },
      "Receipt": {
        "type": "object",
        "required": [
          "receipt_id"
        ],
        "properties": {
          "receipt_id": {
            "type": "string"
          }
        }
      },
      "ShippingInvoice": {
        "type": "object",
        "required": [
          "tracking_code",
          "weight_kg",
          "note"
        ],
        "properties": {
          "note": {
            "$ref": "#/components/schemas/ShippingNote"
          },
          "tracking_code": {
            "type": "string"
          },
          "weight_kg": {
            "type": "number"
          }
        }
      },
      "ShippingNote": {
        "type": "object",
        "required": [
          "courier"
        ],
        "properties": {
          "courier": {
            "type": "string"
          }
        }
      },
      "goldenAddress": {
        "type": "object",
        "required": [
          "street",
          "city"
        ],
        "properties": {
          "city": {
            "type": "string"
          },
          "street": {
            "type": "string",
            "description": "Street address"
          }
        }
      },
      "goldenCreateOrder": {
        "type": "object",
        "required": [
          "reference",
          "address",
          "total"
        ],
        "properties": {
          "address": {
            "$ref": "#/components/schemas/goldenAddress"
          },
          "reference": {
            "type": "string",
            "x-forge-id": true
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "goldenEmbeddedQueryRequestBody": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "goldenMixedTagRequestBody": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string"
          }
        },
        "discriminator": {
          "propertyName": "title",
          "mapping": {
            "note": "#/components/schemas/goldenSummary"
          }
        }
      },
      "goldenOptionalBody": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string"
          },
          "stars": {
            "type": "integer"
          }
        }
      },
      "goldenOrder": {
        "type": "object",
        "required": [
          "created_at",
          "updated_at",
          "revision",
          "order_number",
          "id",
          "status",
          "address",
          "total"
        ],
        "properties": {
          "address": {
            "$ref": "#/components/schemas/goldenAddress"
          },
          "created_at": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "order_number": {
            "type": "string",
            "x-forge-id": true
          },
          "revision": {
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/GoldenOrderStatus"
          },
          "total": {
            "type": "integer",
            "description": "Total in minor units"
          },
          "updated_at": {
            "type": "string"
          }
        }
      },
      "goldenPage_goldenWorkspace": {
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/goldenWorkspace"
            }
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "goldenRecursiveRequestBody": {
        "type": "object",
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string"
          }
        }
      },
      "goldenSelfEmbedded": {
        "type": "object",
        "required": [
          "label",
          "node"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "node": {
            "$ref": "#/components/schemas/goldenTreeNode"
          }
        }
      },
      "goldenSinkRequestBody": {
        "type": "object",
        "required": [
          "body"
        ],
        "properties": {
          "body": {
            "type": "string"
          }
        },
        "discriminator": {
          "propertyName": "body"
        }
      },
      "goldenSummary": {
        "type": "object",
        "required": [
          "summary_id",
          "orders"
        ],
        "properties": {
          "orders": {
            "type": "integer"
          },
          "summary_id": {
            "type": "string",
            "x-forge-id": true
          }
        }
      },
      "goldenTreeNode": {
        "type": "object",
        "required": [
          "label"
        ],
        "properties": {
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/goldenTreeNode"
            }
          },
          "label": {
            "type": "string"
          },
          "parent": {
            "$ref": "#/components/schemas/goldenTreeNode"
          }
        }
      },
      "goldenWorkspace": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  }
}
