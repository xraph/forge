{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,

    // The build config uses NodeNext so that `tsc` enforces the explicit
    // `.js` extensions Node's ESM loader requires of the shipped dist. The
    // tests never go through that loader -- vitest resolves them -- and they
    // import `../src` and `../src/cache` in the extensionless style. Resolving
    // them the bundler way keeps that style working without weakening the
    // guarantee on what actually ships.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    // `dev-guard.test.ts` bundles `dist/` and runs it in a vm realm, so the
    // tests need Node's types. The build config sets this to `[]`; the two
    // together are the point -- available here, absent from what ships.
    "types": ["node"]
  },
  "include": ["src", "__tests__"]
}
