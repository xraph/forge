{
  "name": "@forge-go/client-core",
  "version": "0.1.0",
  "description": "Framework-agnostic runtime for generated Forge clients: normalized entity store, tag graph, query engine and REST transport",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "size": "npm run build && size-limit"
  },
  "size-limit": [
    {
      "name": "entity store",
      "path": "dist/index.js",
      "import": "{ normalize, EntityStore, denormalize }",
      "limit": "2.17 kB",
      "gzip": true
    },
    {
      "name": "tag graph",
      "path": "dist/index.js",
      "import": "{ QueryRegistry, Invalidator, manualScheduler }",
      "limit": "2.2 kB",
      "gzip": true
    },
    {
      "name": "query engine and REST transport",
      "path": "dist/index.js",
      "import": "{ QueryCache, RestTransport, query, mutation, configureClient }",
      "limit": "8.25 kB",
      "gzip": true
    },
    {
      "name": "stream binding",
      "path": "dist/index.js",
      "import": "{ StreamBinder, SubscriptionManager, applyFrames }",
      "limit": "3.4 kB",
      "gzip": true
    },
    {
      "name": "optimistic overlays",
      "path": "dist/index.js",
      "import": "{ OverlayStack }",
      "limit": "1.23 kB",
      "gzip": true
    },
    {
      "name": "core, REST only",
      "path": "dist/index.js",
      "import": "{ QueryCache, RestTransport, EntityStore, query, mutation, configureClient, manualScheduler }",
      "limit": "9 kB",
      "gzip": true
    },
    {
      "name": "core with streams",
      "path": "dist/index.js",
      "limit": "14 kB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.0.0",
    "@types/node": "^22.20.1",
    "esbuild": "^0.25.0",
    "fast-check": "^4.0.0",
    "size-limit": "^11.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT"
}
