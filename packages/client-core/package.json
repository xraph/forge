{
  "name": "@forge-go/client-core",
  "version": "1.9.10",
  "description": "Framework-agnostic runtime for generated Forge clients: normalized entity store, tag graph, query engine and REST transport",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xraph/forge.git",
    "directory": "packages/client-core"
  },
  "homepage": "https://github.com/xraph/forge/tree/main/packages/client-core#readme",
  "bugs": "https://github.com/xraph/forge/issues",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "smoke": "node ../scripts/smoke-esm.mjs",
    "size": "npm run build && size-limit"
  },
  "size-limit": [
    {
      "name": "entity store",
      "path": "dist/index.js",
      "import": "{ normalize, EntityStore, denormalize }",
      "limit": "2.4 kB",
      "gzip": true
    },
    {
      "name": "tag graph",
      "path": "dist/index.js",
      "import": "{ QueryRegistry, Invalidator, manualScheduler }",
      "limit": "2.25 kB",
      "gzip": true
    },
    {
      "name": "query engine and REST transport",
      "path": "dist/index.js",
      "import": "{ QueryCache, RestTransport, query, mutation, configureClient }",
      "limit": "9.32 kB",
      "gzip": true
    },
    {
      "name": "stream binding",
      "path": "dist/index.js",
      "import": "{ StreamBinder, SubscriptionManager, applyFrames }",
      "limit": "3.75 kB",
      "gzip": true
    },
    {
      "name": "optimistic overlays",
      "path": "dist/index.js",
      "import": "{ OverlayStack }",
      "limit": "1.23 kB",
      "gzip": true
    },
    {
      "name": "ssr",
      "path": "dist/index.js",
      "import": "{ dehydrate, hydrate }",
      "limit": "2 kB",
      "gzip": true
    },
    {
      "name": "freshness",
      "path": "dist/index.js",
      "import": "{ revalidateOnFocus, revalidateOnReconnect, poll }",
      "limit": "0.5 kB",
      "gzip": true
    },
    {
      "name": "core, REST only",
      "path": "dist/index.js",
      "import": "{ QueryCache, RestTransport, EntityStore, query, mutation, configureClient, manualScheduler }",
      "limit": "9417 B",
      "gzip": true
    },
    {
      "name": "core with streams",
      "path": "dist/index.js",
      "import": "{ QueryCache, RestTransport, EntityStore, query, mutation, configureClient, manualScheduler, StreamBinder, SubscriptionManager, applyFrames }",
      "limit": "14.25 kB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.0.0",
    "@types/node": "^22.20.1",
    "esbuild": "^0.25.0",
    "fast-check": "^4.0.0",
    "size-limit": "^11.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT"
}
