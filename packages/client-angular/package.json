{
  "name": "@forge-go/client-angular",
  "version": "1.9.8",
  "description": "Angular binding for the Forge client runtime: signals and DestroyRef over the normalized query cache",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xraph/forge.git",
    "directory": "packages/client-angular"
  },
  "homepage": "https://github.com/xraph/forge/tree/main/packages/client-angular#readme",
  "bugs": "https://github.com/xraph/forge/issues",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "smoke": "node ../scripts/smoke-esm.mjs",
    "size": "npm run build && size-limit",
    "sync-peers": "node ../scripts/sync-peer-versions.mjs",
    "prepack": "node ../scripts/sync-peer-versions.mjs"
  },
  "size-limit": [
    {
      "name": "injectQuery",
      "path": "dist/index.js",
      "import": "{ injectQuery }",
      "limit": "1 kB",
      "gzip": true,
      "ignore": [
        "@angular/core",
        "@forge-go/client-core"
      ]
    },
    {
      "name": "adapter",
      "path": "dist/index.js",
      "limit": "2 kB",
      "gzip": true,
      "ignore": [
        "@angular/core",
        "@forge-go/client-core"
      ]
    }
  ],
  "peerDependencies": {
    "@angular/core": ">=17.0.0",
    "@forge-go/client-core": "^1.9.8"
  },
  "devDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@forge-go/client-core": "file:../client-core",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@types/node": "^22.20.1",
    "jsdom": "^26.0.0",
    "rxjs": "^7.8.0",
    "size-limit": "^11.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT"
}
