{
  "description": "Upsert, patch, evict by record and evict by bare id, in three batches",
  "entities": {
    "Customer": {
      "fields": {
        "orders": "Order"
      },
      "idField": "id"
    },
    "Envelope": {
      "fields": {
        "data": "Order",
        "invoice": "Invoice",
        "items": "Order",
        "wrapper": "Envelope"
      }
    },
    "Invoice": {
      "idField": "invoiceNumber"
    },
    "LineItem": {
      "idField": "sku"
    },
    "Order": {
      "fields": {
        "customer": "Customer",
        "invoice": "Invoice",
        "items": "LineItem",
        "related": "Order"
      },
      "idField": "id"
    }
  },
  "expected": {
    "records": {
      "Order:7": {
        "id": 7,
        "total": 100
      }
    }
  },
  "frames": [
    [
      {
        "binding": {
          "channel": "/ws/orders",
          "entity": "Order",
          "intent": "upsert",
          "invalidates": [
            "Order[]"
          ],
          "message": "order.created"
        },
        "payload": {
          "id": 9,
          "total": 5
        }
      }
    ],
    [
      {
        "binding": {
          "channel": "/ws/orders",
          "entity": "Order",
          "intent": "patch",
          "invalidates": [],
          "message": "order.updated"
        },
        "payload": {
          "id": 7,
          "total": 100
        }
      },
      {
        "binding": {
          "channel": "/ws/orders",
          "entity": "Order",
          "intent": "evict",
          "invalidates": [
            "Order[]"
          ],
          "message": "order.deleted"
        },
        "payload": {
          "id": 8
        }
      }
    ],
    [
      {
        "binding": {
          "channel": "/ws/orders",
          "entity": "Order",
          "intent": "evict",
          "invalidates": [
            "Order[]"
          ],
          "message": "order.deleted"
        },
        "payload": 9
      }
    ]
  ],
  "initial": {
    "rootType": "Order",
    "value": [
      {
        "id": 7,
        "total": 1
      },
      {
        "id": 8,
        "total": 2
      }
    ]
  }
}
