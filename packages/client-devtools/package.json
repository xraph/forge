{
  "name": "@forge-go/client-devtools",
  "version": "1.9.10",
  "description": "Dev-only inspector for the Forge client runtime: cache and tag-graph inspection, a bounded causal event log, and the answer to why a query did or did not refetch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xraph/forge.git",
    "directory": "packages/client-devtools"
  },
  "homepage": "https://github.com/xraph/forge/tree/main/packages/client-devtools#readme",
  "bugs": "https://github.com/xraph/forge/issues",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./overlay": {
      "types": "./dist/overlay.d.ts",
      "import": "./dist/overlay.js"
    },
    "./panel": {
      "types": "./dist/panel.d.ts",
      "import": "./dist/panel.js"
    },
    "./mini": {
      "types": "./dist/mini.d.ts",
      "import": "./dist/mini.js"
    },
    "./requests": {
      "types": "./dist/requests.d.ts",
      "import": "./dist/requests.js"
    },
    "./control": {
      "types": "./dist/control.d.ts",
      "import": "./dist/control.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "smoke": "node ../scripts/smoke-esm.mjs",
    "size": "npm run build && size-limit",
    "sync-peers": "node ../scripts/sync-peer-versions.mjs",
    "prepack": "node ../scripts/sync-peer-versions.mjs"
  },
  "size-limit": [
    {
      "name": "inspection API",
      "path": "dist/index.js",
      "limit": "6.5 kB",
      "gzip": true,
      "ignore": [
        "@forge-go/client-core"
      ]
    },
    {
      "name": "overlay (the full panel)",
      "path": "dist/overlay.js",
      "limit": "16 kB",
      "gzip": true,
      "ignore": [
        "@forge-go/client-core"
      ]
    },
    {
      "name": "the lean view",
      "path": "dist/mini.js",
      "limit": "3.5 kB",
      "gzip": true,
      "ignore": [
        "@forge-go/client-core"
      ]
    },
    {
      "name": "panel",
      "path": "dist/panel.js",
      "limit": "16 kB",
      "gzip": true,
      "ignore": [
        "@forge-go/client-core"
      ]
    },
    {
      "name": "request recording",
      "path": "dist/requests.js",
      "limit": "1.5 kB",
      "gzip": true,
      "ignore": [
        "@forge-go/client-core"
      ]
    },
    {
      "name": "network controls",
      "path": "dist/control.js",
      "limit": "1.5 kB",
      "gzip": true,
      "ignore": [
        "@forge-go/client-core"
      ]
    },
    {
      "name": "inspector and the lean view together",
      "path": [
        "dist/index.js",
        "dist/mini.js"
      ],
      "limit": "10 kB",
      "gzip": true,
      "ignore": [
        "@forge-go/client-core"
      ]
    }
  ],
  "peerDependencies": {
    "@forge-go/client-core": "^1.9.10"
  },
  "devDependencies": {
    "@forge-go/client-core": "file:../client-core",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@types/node": "^22.20.1",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "size-limit": "^11.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT"
}
