{
  "name": "@forge-go/client-vue",
  "version": "1.9.10",
  "description": "Vue 3 binding for the Forge client runtime: shallowRef and effectScope over the normalized query cache",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xraph/forge.git",
    "directory": "packages/client-vue"
  },
  "homepage": "https://github.com/xraph/forge/tree/main/packages/client-vue#readme",
  "bugs": "https://github.com/xraph/forge/issues",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "smoke": "node ../scripts/smoke-esm.mjs",
    "size": "npm run build && size-limit",
    "sync-peers": "node ../scripts/sync-peer-versions.mjs",
    "prepack": "node ../scripts/sync-peer-versions.mjs"
  },
  "size-limit": [
    {
      "name": "useQuery",
      "path": "dist/index.js",
      "import": "{ useQuery }",
      "limit": "1 kB",
      "gzip": true,
      "ignore": [
        "vue",
        "@forge-go/client-core"
      ]
    },
    {
      "name": "useInvalidate",
      "path": "dist/index.js",
      "import": "{ useInvalidate }",
      "limit": "1 kB",
      "gzip": true,
      "ignore": [
        "vue",
        "@forge-go/client-core"
      ]
    },
    {
      "name": "adapter",
      "path": "dist/index.js",
      "limit": "2 kB",
      "gzip": true,
      "ignore": [
        "vue",
        "@forge-go/client-core"
      ]
    }
  ],
  "peerDependencies": {
    "@forge-go/client-core": "^1.9.10",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@forge-go/client-core": "file:../client-core",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@types/node": "^22.20.1",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^26.0.0",
    "size-limit": "^11.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0",
    "vue": "^3.5.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT"
}
