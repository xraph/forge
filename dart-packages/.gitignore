.dart_tool/
.fvm/
build/
pubspec.lock

# The repo root .gitignore ignores every directory named `test`. These packages
# keep their tests in tracked `test/` directories, so un-ignore them.
!test/
!test/**

# pub reads this file too. Git still ignores the devtools build through the
# package's own .gitignore; pub ships it through the package's .pubignore.
!forge_client_devtools/extension/devtools/build/
